# Copy this file to .env before running docker compose.
#
# Generate a real secret, for example:
#   openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

# Admin UI/API login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-password

# Restart all enabled exits every night at server-local midnight.
# Use "disabled" to turn off the scheduled restart.
NIGHTLY_RESTART_EXITS_CRON="0 0 * * *"
