# Copy this file to .env before running docker compose.
#
# Generate a real secret, for example:
#   openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

# Admin UI/API login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Restart all enabled exits every 12 hours.
# Use "disabled" to turn off the scheduled restart.
EXIT_RESTART_CRON="@every 12h"

# Check active custom WireGuard hostname endpoints for DNS changes. Use 0 to disable.
WIREGUARD_DDNS_CHECK_INTERVAL=30s

# Close TLS connections after this long without traffic in either direction.
TLS_IDLE_TIMEOUT=5m

# Simultaneous TCP/TLS connections across all exits.
TLS_MAX_CONNECTIONS=2048
